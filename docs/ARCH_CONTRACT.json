  "requirements": [
    {
      "id": "R-RESET",
      "tasks": [
        "T006",
        "T022",
        "T029"
      ],
      "text": "Synchronous reset clears architectural/core protocol state; shared reset cancels outstanding local transactions.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-ISA",
      "tasks": [
        "T004",
        "T005",
        "T007",
        "T008",
        "T012",
        "T041"
      ],
      "text": "All 40 base instructions, legal HINTs and chosen EEI behavior are traced to independent tests.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-X0",
      "tasks": [
        "T006",
        "T020",
        "T023"
      ],
      "text": "x0 stays zero; loads targeting x0 still perform access and fault/side effects.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-RF",
      "tasks": [
        "T006"
      ],
      "text": "Two combinational reads, one retirement-edge write, same-cycle WB-to-ID bypass.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-MEM",
      "tasks": [
        "T009",
        "T017",
        "T026"
      ],
      "text": "One outstanding request per bus, stable stalled payload, no duplicate acceptance, synchronous responses.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-LANES",
      "tasks": [
        "T008",
        "T028"
      ],
      "text": "Byte enables and lane shifts match original byte effective address; misalignment faults before request.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-FETCH-KILL",
      "tasks": [
        "T016",
        "T017"
      ],
      "text": "Redirect/fault kills stale fetch results while preserving already-offered request stability.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-FWD",
      "tasks": [
        "T014"
      ],
      "text": "Nearest valid older result wins; no x0/invalid/load-not-ready forwarding.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-LOAD-USE",
      "tasks": [
        "T015",
        "T017"
      ],
      "text": "Dependent consumer waits until a legal WB bypass exists; store data and branch/JALR operands included.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-HOLD",
      "tasks": [
        "T017",
        "T022"
      ],
      "text": "MEM wait holds younger stages but WB retires at most once; no stale operand after extended stall.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-REDIRECT",
      "tasks": [
        "T007",
        "T016"
      ],
      "text": "EX resolves branches and jumps; taken misaligned target faults; wrong-path effects never commit.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-FAULT",
      "tasks": [
        "T011",
        "T020",
        "T041"
      ],
      "text": "Oldest precise fault wins; faulting/younger instructions do not retire or issue memory effects.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-STORE-ORDER",
      "tasks": [
        "T017",
        "T020",
        "T041"
      ],
      "text": "Store/read-side effects occur once at successful response acceptance, only after older faults are excluded.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-RETIRE",
      "tasks": [
        "T011",
        "T018",
        "T019"
      ],
      "text": "One ordered successful retirement event, stable metadata, separate sticky fault observation.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-FENCE",
      "tasks": [
        "T041"
      ],
      "text": "Conservative full I/O/read/write drain, including ignored future FENCE fields; no younger effect before completion.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-MAP",
      "tasks": [
        "T025",
        "T026",
        "T028"
      ],
      "text": "ROM/RAM/MMIO regions and access permissions agree with linker and fabric; unmapped access errors.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-UART",
      "tasks": [
        "T027",
        "T042"
      ],
      "text": "TX/RX 8N1, clock-enable timing, synchronization, backpressure, framing/overrun and partial access semantics.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-CDC",
      "tasks": [
        "T029"
      ],
      "text": "One core/SoC clock; synchronized reset release and external inputs, documented CDC reports.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-CLOCK",
      "tasks": [
        "T025",
        "T030",
        "T043"
      ],
      "text": "100 MHz board source and 10 ns constraint, with routed setup/hold evidence required separately.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-TOOLCHAIN",
      "tasks": [
        "T003"
      ],
      "text": "Real executable lint and simulation gates and pinned versions; missing checks cannot pass.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-CLOSURE",
      "tasks": [
        "T024",
        "T032",
        "T039",
        "T040"
      ],
      "text": "DV, physical FPGA and ASIC evidence remain distinct and final owner review remains mandatory.",
      "implementation_evidence": "NOT RUN"
    },
    {
      "id": "R-IRQ",
      "tasks": [
        "T044",
        "T045",
        "T032"
      ],
      "text": "Later interrupt support requires a separately approved trap/CSR revision, precise timer interrupt verification and authorized hardware evidence.",
      "implementation_evidence": "NOT RUN"
    }
